# CasperProver runtime configuration
CASPER_NODE_URL=https://node.testnet.casper.network
CASPER_CHAIN=casper-test
DEPLOYER_KEY_PATH=./keys/secret_key.pem

API_PORT=10000
# API_KEY protects write endpoints (X-API-Key header). Optional in dev.
# REQUIRED when CP_STRICT=1 — the server refuses to start unauthenticated in
# strict mode. /health returns status=degraded if strict+key/submitter mismatch.
API_KEY=
# Production: fail closed when an anchored request cannot reach Casper.
# When CP_STRICT=1 you MUST also set API_KEY and DEPLOYER_KEY_PATH —
# otherwise startup aborts (key missing) or /health reports degraded.
CP_STRICT=0

CONTRACT_PROOF_REGISTRY=
CONTRACT_VERIFIER_GATE=
CONTRACT_DEFI_MOCK=
CONTRACT_STAKE_SLASHING=
DATABASE_URL=
