# CasperProver runtime configuration
CASPER_NODE_URL=https://node.testnet.casper.network
CASPER_CHAIN=casper-test
DEPLOYER_KEY_PATH=./keys/secret_key.pem

API_PORT=10000
API_KEY=
# Production: fail closed when an anchored request cannot reach Casper.
CP_STRICT=0

CONTRACT_PROOF_REGISTRY=
CONTRACT_VERIFIER_GATE=
CONTRACT_DEFI_MOCK=
CONTRACT_STAKE_SLASHING=
DATABASE_URL=

# ------------------------------------------------------------------
# LLM adapter — multi-provider parallel fan-out (Gate 3)
# ------------------------------------------------------------------
# Backend-only. Never exposed to the frontend. Never committed.
# Each provider may supply one or more keys (comma-separated within a
# single variable OR via numbered aliases like GROQ_API_KEY / GROQ2_API_KEY).
# The KeyRing round-robins across all keys of a provider and cools down
# a key that hits a 429/5xx.

# Tier: fast (parallel fan-out)
GROQ_API_KEY=
GROQ2_API_KEY=
NVIDIA_API_KEY=

# Tier: fast aggregator
OPENROUTER_API_KEY=
OPENROUTER2_API_KEY=

# Tier: reliability
ZAI_API_KEY=
ZAI2_API_KEY=
GEMINI_API_KEY=

# Fixture fallback (deterministic; used when every real provider fails).
# Set to 1 to force fixture mode (dev/CI without keys).
LLM_FIXTURE_MODE=0
# Per-provider request timeout (ms); default 3000.
LLM_PROVIDER_TIMEOUT_MS=3000
# Total budget across all tiers (ms); default 8000.
LLM_TOTAL_BUDGET_MS=8000

